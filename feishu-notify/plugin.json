{
  "id": "feishu-notify",
  "name": "Feishu Notify",
  "version": "0.1.0",
  "description": "订阅 dinotty 服务端事件并推送到飞书自定义机器人",
  "category": "other",
  "icon": "bell",
  "entry": "./main.js",
  "styles": "./styles.css",
  "events": [
    "auth.verification_code",
    "auth.verification_code_consumed"
  ],
  "commands": [
    {
      "id": "feishu-notify.open",
      "title": "打开飞书通知配置"
    }
  ],
  "minAppVersion": "0.1.0",
  "permissions": [],
  "targets": [
    "windows-x86_64",
    "linux-x86_64",
    "linux-aarch64",
    "macos-x86_64",
    "macos-aarch64"
  ]
}
