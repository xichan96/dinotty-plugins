{
  "name": "session-browser",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=dist/cli --target=node18 --banner:js=\"#!/usr/bin/env node\"",
    "build:windows-launcher": "cd native && rustc --edition=2021 --target x86_64-pc-windows-msvc -C opt-level=s -C strip=symbols -o ../dist/cli-wrapper.exe windows-launcher.rs && node write-windows-launcher-provenance.js",
    "build:ui": "esbuild src/ui.ts --bundle --format=esm --outfile=dist/main.js --platform=browser",
    "set:cli-executable": "node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/cli', 0o755)\"",
    "build": "npm run build:cli && npm run build:ui && npm run set:cli-executable",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:cli && node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "~5.7.0"
  },
  "dependencies": {
    "lucide": "^1.21.0"
  }
}
